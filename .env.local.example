# Google Photos API Configuration
# Para obtener estas credenciales:
# 1. Ve a https://console.cloud.google.com/
# 2. Crea un nuevo proyecto o selecciona uno existente
# 3. Habilita "Photos Library API"
# 4. Ve a "Credentials" y crea:
#    - API Key (para VITE_GOOGLE_API_KEY)
#    - OAuth 2.0 Client ID (Web application) (para VITE_GOOGLE_CLIENT_ID)
# 5. En OAuth 2.0 Client, añade estos URIs autorizados:
#    - http://localhost:5173 (desarrollo)
#    - https://tu-dominio.com (producción)

VITE_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your-api-key-here

# Dropbox Chooser Configuration
# Para obtener el App Key:
# 1. Ve a https://www.dropbox.com/developers/apps
# 2. Crea una nueva app (Scoped access, Full Dropbox)
# 3. En la pestaña Settings, copia el "App key"
# 4. En "Chooser/Saver/Embedder domains", añade tu dominio (localhost para desarrollo)

VITE_DROPBOX_APP_KEY=your-dropbox-app-key-here

# Upload format: "jpeg" (default) or "webp" (same quality, ~30-40% smaller files in R2)
VITE_UPLOAD_FORMAT=jpeg

# Enable/disable real purchase modals in Settings
# Set to "true" to enable real purchase modals, "false" to show "coming soon" placeholder
VITE_ENABLE_REAL_PURCHASE=true

# Lightroom plugin update notification
# When set, users with preferredSource='lightroom' will see a "Plugin update available" modal on login.
# Increment this number each time you release a new plugin version to show the notification again
# even to users who previously dismissed it. Remove or leave empty to disable the notification.
# VITE_LR_PLUGIN_VERSION=1

# Analytics (app)
# GA4 measurement ID (same one you use in landing if you want a single funnel)
# Example: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Google Ads conversion tracking for signup event
# Example ID: AW-1234567890
VITE_GOOGLE_ADS_ID=
# Conversion label from Google Ads for the "conversion_event_signup" action
# Example label: AbCdEfGhIjKlMnOpQr
VITE_GOOGLE_ADS_SIGNUP_LABEL=
