TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Regularización de scores artísticos entre fotos casi idénticas.
# ENABLED  : engancha el motor al final de cada análisis (por defecto, apagado)
# STRATEGY : cómo se decide que dos fotos son la misma toma — clip | dhash | both
#            En producción siempre `dhash`: CLIP es demasiado lento y caro para
#            recorrer un catálogo entero. Los otros dos valores no se usan.
SCORES_SMOOTHING_ENABLED=false
SCORES_SMOOTHING_STRATEGY=dhash

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=http://localhost:5173/settings?payment=success
STRIPE_CANCEL_URL=http://localhost:5173/settings?payment=cancelled
STRIPE_CATALOG_CURRENCY=eur

# Backblaze B2 backup deletion (S3-compatible API)
B2_ENDPOINT=https://s3.YOUR_REGION.backblazeb2.com
B2_REGION=YOUR_REGION
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=curatorlab-backup